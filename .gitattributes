# 换行统一：Linux 脚本必须 LF，否则服务器上报 $'\r': command not found
*.sh            text eol=lf
scripts/*.sh    text eol=lf
*.service       text eol=lf
*.py            text eol=lf
*.md            text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.json          text eol=lf
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.vbs           text eol=crlf
